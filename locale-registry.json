{
  "site": "https://clamoa.com",
  "defaultLocale": "ko",
  "xDefault": "ko",
  "urlStrategy": "path-prefix",
  "slugPolicy": "stable",
  "scope": {
    "localized": ["/"],
    "koreanOnly": [
      "/about",
      "/services",
      "/services/*",
      "/case-studies",
      "/process",
      "/insights",
      "/insights/*",
      "/faq",
      "/contact",
      "/star",
      "/magazine",
      "/influencer",
      "/event",
      "/brand-ambassador",
      "/viral",
      "/privacy",
      "/terms"
    ],
    "note": "Only the one-page home experience is localized so far. Korean-only pages are excluded from the hreflang cluster; do not emit alternates for them until translated."
  },
  "locales": [
    {
      "code": "ko",
      "bcp47": "ko-KR",
      "prefix": "",
      "dir": "ltr",
      "label": "한국어",
      "ogLocale": "ko_KR",
      "priority": "primary",
      "formality": "polite (해요/합니다체)"
    },
    {
      "code": "en",
      "bcp47": "en",
      "prefix": "/en",
      "dir": "ltr",
      "label": "English",
      "ogLocale": "en_US",
      "priority": "primary",
      "formality": "professional neutral"
    },
    {
      "code": "ja",
      "bcp47": "ja-JP",
      "prefix": "/ja",
      "dir": "ltr",
      "label": "日本語",
      "ogLocale": "ja_JP",
      "priority": "secondary",
      "formality": "です・ます体"
    },
    {
      "code": "zh",
      "bcp47": "zh-Hans",
      "prefix": "/zh",
      "dir": "ltr",
      "label": "简体中文",
      "ogLocale": "zh_CN",
      "priority": "secondary",
      "formality": "business-standard Simplified Chinese"
    },
    {
      "code": "vi",
      "bcp47": "vi-VN",
      "prefix": "/vi",
      "dir": "ltr",
      "label": "Tiếng Việt",
      "ogLocale": "vi_VN",
      "priority": "secondary",
      "formality": "trang trọng, xưng 'chúng tôi'"
